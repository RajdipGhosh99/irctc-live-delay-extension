{
  "manifest_version": 3,
  "name": "Live Train Delay Tracker",
  "version": "2.0.0",
  "description": "Real-time live train delay tracker & historical punctuality across ConfirmTkt, MakeMyTrip, ClearTrip & Ixigo.",
  "homepage_url": "https://github.com/RajdipGhosh99",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.confirmtkt.com/*",
    "*://confirmtkt.com/*",
    "*://*.makemytrip.com/*",
    "*://makemytrip.com/*",
    "*://www.irctc.co.in/*",
    "*://irctc.co.in/*",
    "*://*.cleartrip.com/*",
    "*://cleartrip.com/*",
    "*://*.ixigo.com/*",
    "*://ixigo.com/*",
    "*://*.goibibo.com/*",
    "*://goibibo.com/*",
    "*://*.paytm.com/*",
    "*://paytm.com/*",
    "*://*.easemytrip.com/*",
    "*://easemytrip.com/*",
    "*://*.railyatri.in/*",
    "*://railyatri.in/*",
    "https://*.rapidapi.com/*",
    "https://*.indianrailapi.com/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Train Delay Tracker by Rajdip Ghosh",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.confirmtkt.com/*",
        "*://confirmtkt.com/*",
        "*://*.makemytrip.com/*",
        "*://makemytrip.com/*",
        "*://www.irctc.co.in/*",
        "*://irctc.co.in/*",
        "*://*.cleartrip.com/*",
        "*://cleartrip.com/*",
        "*://*.ixigo.com/*",
        "*://ixigo.com/*",
        "*://*.goibibo.com/*",
        "*://goibibo.com/*",
        "*://*.paytm.com/*",
        "*://paytm.com/*",
        "*://*.easemytrip.com/*",
        "*://easemytrip.com/*",
        "*://*.railyatri.in/*",
        "*://railyatri.in/*"
      ],
      "js": [
        "src/content/index.iife.ts"
      ],
      "css": [
        "src/styles/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
