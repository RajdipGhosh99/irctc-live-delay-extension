{
  "manifest_version": 3,
  "name": "Live Train Delay Tracker",
  "version": "1.5.0",
  "description": "Real-time train running delay tracker with Multi-Token API pools, on-demand hover fetching, and site toggles across IRCTC, MakeMyTrip, ConfirmTkt, ClearTrip & Ixigo.",
  "homepage_url": "https://github.com/RajdipGhosh99",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://www.irctc.co.in/*",
    "*://irctc.co.in/*",
    "*://*.makemytrip.com/*",
    "*://makemytrip.com/*",
    "*://*.confirmtkt.com/*",
    "*://confirmtkt.com/*",
    "*://*.cleartrip.com/*",
    "*://cleartrip.com/*",
    "*://*.ixigo.com/*",
    "*://ixigo.com/*",
    "*://*.goibibo.com/*",
    "*://goibibo.com/*",
    "*://*.paytm.com/*",
    "*://paytm.com/*",
    "*://*.easemytrip.com/*",
    "*://easemytrip.com/*",
    "*://*.railyatri.in/*",
    "*://railyatri.in/*",
    "https://*.rapidapi.com/*",
    "https://*.indianrailapi.com/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Train Delay Tracker by Rajdip Ghosh",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.irctc.co.in/*",
        "*://irctc.co.in/*",
        "*://*.makemytrip.com/*",
        "*://makemytrip.com/*",
        "*://*.confirmtkt.com/*",
        "*://confirmtkt.com/*",
        "*://*.cleartrip.com/*",
        "*://cleartrip.com/*",
        "*://*.ixigo.com/*",
        "*://ixigo.com/*",
        "*://*.goibibo.com/*",
        "*://goibibo.com/*",
        "*://*.paytm.com/*",
        "*://paytm.com/*",
        "*://*.easemytrip.com/*",
        "*://easemytrip.com/*",
        "*://*.railyatri.in/*",
        "*://railyatri.in/*"
      ],
      "js": ["src/content.ts"],
      "css": ["src/styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "options.html",
        "popup.html",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
